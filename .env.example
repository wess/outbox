# Core
DATABASE_URL=postgres://outbox:outbox@localhost:55432/outbox
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
PUBLIC_URL=http://localhost:3000

# Delivery
# smtp   — talk to recipient MX servers directly (needs port 25 outbound + PTR)
# relay  — hand off to an upstream SMTP relay (SES, Postmark, your own Postfix)
# console — print to stdout, deliver nothing (default for local dev)
OUTBOX_TRANSPORT=console
OUTBOX_HOSTNAME=localhost

# relay transport
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASS=
SMTP_RELAY_SECURE=starttls

# Inbound SMTP server (receiving)
INBOUND_ENABLED=false
INBOUND_PORT=2525

# Workers
WORKER_CONCURRENCY=8
WORKER_POLL_MS=1000

# Limits
RATE_LIMIT_PER_SECOND=10
MAX_ATTACHMENT_BYTES=41943040

# Object storage (optional)
# Attachments and stored raw messages go to an S3-compatible bucket when this is
# set, and stay inline in Postgres when it is not. Leave STORAGE_ENDPOINT empty
# for AWS S3, where the region determines it.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=outbox
